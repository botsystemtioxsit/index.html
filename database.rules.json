{
  "rules": {
    ".write": true,
    "$other": {
      ".read": true
    },
    "users": {
      ".indexOn": [
        "playerId",
        "role",
        "pendingNameStatus",
        "createdAt"
      ],
      "$uid": {
        "role": {
          ".validate": "newData.val() === 'user' || newData.val() === 'moderator'"
        },
        "status": {
          ".validate": "(!newData.exists() || newData.val() === 'active' || newData.val() === 'restricted' || newData.val() === 'banned') && (!root.child('owners').child($uid).exists() || (auth != null && root.child('owners').child($uid).val() === auth.uid))"
        },
        "points": {
          ".validate": "(!newData.exists() || newData.isNumber()) && (!root.child('owners').child($uid).exists() || (auth != null && root.child('owners').child($uid).val() === auth.uid))"
        },
        "starsBalance": {
          ".validate": "(!newData.exists() || (newData.isNumber() && newData.val() >= 0)) && (!root.child('owners').child($uid).exists() || (auth != null && root.child('owners').child($uid).val() === auth.uid))"
        },
        "firstName": {
          ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 64)"
        },
        "deviceToken": {
          ".validate": "!newData.exists() || newData.val().matches(/^[0-9a-f]+$/)"
        },
        "panelLocked": {
          ".validate": "!newData.exists() || newData.isBoolean()"
        },
        "permissions": {
          "$permKey": {
            ".validate": "newData.isBoolean()"
          }
        },
        "trustedDevices": {
          "$deviceKey": {
            ".validate": false
          }
        },
        "pendingName": {
          ".validate": "!newData.exists() || (newData.isString() && newData.val().length > 0 && newData.val().length <= 24)"
        },
        "pendingNameStatus": {
          ".validate": "!newData.exists() || newData.val() === 'pending' || newData.val() === 'rejected'"
        },
        "pendingNameRejectionReason": {
          ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 300)"
        }
      },
      ".read": true
    },
    "accessTokens": {
      "$token": {
        "label": {
          ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 64)"
        },
        "createdAt": {
          ".validate": "!newData.exists() || newData.isNumber()"
        },
        "createdBy": {
          ".validate": "!newData.exists() || newData.isString()"
        },
        "permissions": {
          "$permKey": {
            ".validate": "newData.isBoolean()"
          }
        },
        ".read": true
      },
      ".read": false
    },
    "logs": {
      ".indexOn": [
        "targetKey"
      ],
      ".read": true
    },
    "queue": {
      ".indexOn": [
        "league"
      ],
      ".read": true
    },
    "matches": {
      ".indexOn": [
        "finishedAt"
      ],
      ".read": true
    },
    "deviceTrustRequests": {
      ".indexOn": [
        "status"
      ],
      ".read": true
    },
    "clans": {
      "$code": {
        "name": {
          ".validate": "!newData.exists() || (newData.isString() && newData.val().length > 0 && newData.val().length <= 24)"
        },
        "status": {
          ".validate": "!newData.exists() || newData.val() === 'pending' || newData.val() === 'approved' || newData.val() === 'rejected'"
        },
        "chatLinkStatus": {
          ".validate": "!newData.exists() || newData.val() === 'pending' || newData.val() === 'approved' || newData.val() === 'rejected'"
        }
      },
      ".read": true
    },
    "videochat": {
      "communities": {
        ".indexOn": [
          "joinCode"
        ]
      },
      ".read": true
    },
    "battles": {
      "$code": {
        ".validate": "newData.hasChildren(['hostId'])"
      },
      ".read": true
    },
    "owners": {
      "$id": {
        ".validate": "!data.exists() && newData.isString() && auth != null && newData.val() === auth.uid"
      },
      ".read": false
    },
    "emailLogins": {
      ".read": false,
      "$key": {
        ".read": true
      }
    },
    "usernames": {
      ".read": false,
      "$key": {
        ".read": true
      }
    },
    "devicePairings": {
      ".read": false,
      "$code": {
        ".read": true
      }
    },
    "googleLinks": {
      ".read": false
    },
    "resetConfirmations": {
      ".read": false
    },
    "assistantRequests": {
      ".read": false
    },
    "launcherFeedback": {
      ".read": false,
      "$id": {
        ".read": true,
        "type": {
          ".validate": "newData.val() === 'bug' || newData.val() === 'idea' || newData.val() === 'other'"
        },
        "text": {
          ".validate": "newData.isString() && newData.val().length <= 4000"
        },
        "status": {
          ".validate": "newData.val() === 'new' || newData.val() === 'work' || newData.val() === 'done' || newData.val() === 'rejected'"
        },
        "createdAt": {
          ".validate": "newData.isNumber()"
        },
        "shots": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 3"
        },
        "contact": {
          ".validate": "newData.isString() && newData.val().length <= 100"
        },
        "system": {
          ".validate": "newData.isString() && newData.val().length <= 500"
        },
        "reply": {
          ".validate": "newData.isString() && newData.val().length <= 2000"
        },
        "replyAt": {
          ".validate": "newData.isNumber()"
        },
        "account": {
          "id": {
            ".validate": "newData.isString() && newData.val().length <= 64"
          },
          "name": {
            ".validate": "newData.isString() && newData.val().length <= 64"
          },
          "playerId": {
            ".validate": "newData.isString() && newData.val().length <= 24"
          },
          "$other": {
            ".validate": false
          }
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "launcherFeedbackShots": {
      ".read": false,
      "$id": {
        ".read": true,
        "$n": {
          ".validate": "newData.isString() && newData.val().length <= 400000 && newData.val().matches(/^data:image\\/jpeg;base64,/)"
        }
      }
    },
    "launcherFeedbackNew": {
      ".read": false,
      "$id": {
        ".validate": "newData.isBoolean()"
      }
    }
  }
}
